{
    "name": "job-finder",
    "version": "1.0.0",
    "description": "Bun/Express job scraper + daily LinkedIn outreach email system, with a Next.js UI",
    "type": "module",
    "private": true,
    "packageManager": "bun@1.3.14",
    "engines": {
        "bun": ">=1.2.0"
    },
    "workspaces": [
        "web"
    ],
    "scripts": {
        "dev": "concurrently -n api,web -c blue,green \"bun --watch src/server.ts\" \"bun run dev:web\"",
        "dev:api": "bun --watch src/server.ts",
        "dev:web": "bun run --filter=job-finder-web dev",
        "build": "bun run typecheck && tsc -p tsconfig.json && bun run build:web",
        "build:web": "bun run --filter=job-finder-web build",
        "start": "concurrently -n api,web -c blue,green \"bun dist/server.js\" \"bun run start:web\"",
        "start:api": "bun dist/server.js",
        "start:web": "bun run --filter=job-finder-web start",
        "typecheck": "tsc -p tsconfig.json --noEmit && bun run --filter=job-finder-web typecheck"
    },
    "dependencies": {
        "cheerio": "^1.1.2",
        "express": "^4.21.2",
        "googleapis": "^164.0.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^7.0.9",
        "pino": "^10.1.0",
        "yaml": "^2.8.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/express": "^4.17.25",
        "@types/node": "^24.10.1",
        "@types/nodemailer": "^7.0.4",
        "concurrently": "^9.2.1",
        "pino-pretty": "^13.1.2",
        "typescript": "^5.9.3"
    }
}