# Bun loads this file automatically (bun run dev, bun start, bun src/server.ts).
# Copy to .env and fill in what you need.

# ─── Required: PostgreSQL ───
# Any Postgres works — Neon, Supabase, or a local server. Paste the connection
# string from your provider's dashboard ("Connect" / "Connection pooler").
#
#   Neon      postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   Supabase  postgresql://postgres.abcdefghij:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#   Local     postgresql://postgres:postgres@localhost:5432/job_finder
#
# Prefer the *pooled* endpoint (-pooler / :6543) on serverless providers.
# Tables, indexes and the first-run profile are created automatically on boot.
DATABASE_URL=

# Optional Postgres tuning. PG_SSL is auto-detected when unset
# (TLS for hosted providers, plain for localhost): true | false.
# PG_SSL=
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=10000

# ─── Required for JSearch (LinkedIn/Indeed/Glassdoor aggregator) ───
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
RAPIDAPI_KEY=17d3bdb40cmsh7a46217bed82e2fp129679jsne3f808a98a66

# ─── Required for Daily Email Digest ───
# Must use Gmail App Password, NOT your regular password
# Generate at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled first)
SENDER_EMAIL=108tiwari.g@gmail.com
SENDER_APP_PASSWORD=mldc ptfu plqu eykk
RECIPIENT_EMAIL=khushi.g9770@gmail.com

# ─── Daily Digest Timing (IST timezone) ───
DAILY_EMAIL_HOUR=9
DAILY_JOBS_COUNT=15

# ─── Server ───
HOST=127.0.0.1
PORT=8000

# ─── Optional: Hunter.io (not actively used — LinkedIn search replaces it) ───
HUNTER_API_KEY=

# ─── Optional: Google Sheets Export ───
GOOGLE_SHEETS_CREDS=credentials.json
GOOGLE_SHEET_ID=

# ─── Logging ───
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── One-off SQLite import (optional) ───
# Used only by `bun run db:import`; defaults to job-finder/jobs.db.
# LEGACY_DB_PATH=jobs.db
